# .env.example
# Get your key at https://cloud.debank.com/
DEBANK_API_KEY=
# Get your key at https://portal.1inch.dev/
ONE_INCH_API_KEY=
# X OAuth 2.0 Authorization Code + PKCE (server-side only). The URI must be
# registered with the X developer application. Production must use the exact URI below.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://dustengine.xyz/api/auth/x/callback
# Secret used only by trusted server-side/indexer jobs to record verified Ambassador activity.
AMBASSADOR_ADMIN_TOKEN=
# Server-only Base RPC used to independently verify confirmed Clean Dust transactions.
BASE_RPC_URL=
# Optional; defaults to 3. Number of Base blocks required before awarding Clean Dust points.
AMBASSADOR_MIN_CONFIRMATIONS=3
