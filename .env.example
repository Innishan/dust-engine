# .env.example
# Get your key at https://cloud.debank.com/
DEBANK_API_KEY=
# Get your key at https://portal.1inch.dev/
ONE_INCH_API_KEY=
# Server-only Base ERC-20 discovery provider. Candidate
# addresses are always independently verified against Base RPC before use.
ALCHEMY_API_KEY=
# X OAuth 2.0 Authorization Code + PKCE (server-side only). The URI must be
# registered with the X developer application. Production must use the exact URI below.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://dustengine.xyz/api/auth/x/callback
# Automatic Ambassador X-content detection and quality evaluation (server-side only).
X_BEARER_TOKEN=
GEMINI_API_KEY=
X_CONTENT_RECOVERY_INTERVAL_MS=86400000
GEMINI_MODEL=
# Secret used only by trusted server-side/indexer jobs to record verified Ambassador activity.
AMBASSADOR_ADMIN_TOKEN=
# Server-only Base RPC used to independently verify confirmed Clean Dust transactions.
BASE_RPC_URL=
# Optional; defaults to 3. Number of Base blocks required before awarding Clean Dust points.
AMBASSADOR_MIN_CONFIRMATIONS=3

# Dust Genesis campaign. The profile link is fixed to x.com/dustengineapp; configure the official announcement URL before enabling the campaign.
# The announcement URL must be an HTTPS link on x.com or twitter.com.
DUST_GENESIS_X_ANNOUNCEMENT_URL=
# New Dust Genesis contract only; never set this to the existing Dust Engine address.
DUST_GENESIS_CONTRACT_ADDRESS=
# Dedicated backend signer whose address must match the new contract's authorizedSigner.
DUST_GENESIS_SIGNER_PRIVATE_KEY=
# Deployment-only values; keep real keys in a protected environment, never in source control.
DUST_GENESIS_DEPLOYER_PRIVATE_KEY=
DUST_GENESIS_EXPECTED_DEPLOYER_ADDRESS=
DUST_GENESIS_OWNER_ADDRESS=
DUST_GENESIS_EXPECTED_OWNER_ADDRESS=
DUST_GENESIS_SIGNER_ADDRESS=
DUST_GENESIS_EXPECTED_SIGNER_ADDRESS=
DUST_GENESIS_METADATA_URI=
